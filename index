const uid  = () => Date.now()+Math.random().toString(36).slice(2,6);
const today= () => new Date().toISOString().slice(0,10);

// save() / load() : Firebase en priorité, localStorage en fallback
function save() {
  if (_dbRef) {
    _dbRef.set(DB).catch(e => console.warn('Firebase save DB :', e));
  } else {
    try { localStorage.setItem('ecobuild', JSON.stringify(DB)); } catch(e) {}
  }
}
function load() {
  // Chargement synchrone (localStorage uniquement) — utilisé seulement si pas Firebase
  try { const d = localStorage.getItem('ecobuild'); if (d) DB = JSON.parse(d); } catch(e) {}
}

