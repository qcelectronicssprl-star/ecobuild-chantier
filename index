        </div>
        <div style="text-align:right">
          <div style="font-size:.85rem;font-weight:700;color:${over?'#FCA5A5':'#6EE7B7'}">${fmtN(depTotal)} / ${fmtN(p.budgetTotal)} FCFA</div>
          <div style="font-size:.65rem;color:var(--gris-l)">${pct}% consommé${over?' ⚠️ DÉPASSEMENT':''}</div>
        </div>
      </div>
      <table class="tbl" style="border-radius:0 0 8px 8px;overflow:hidden">
        <thead><tr><th>Catégorie</th><th style="text-align:right">Budget prévu</th><th style="text-align:right">Réel engagé</th><th style="text-align:right">Écart</th><th style="min-width:150px">Avancement</th></tr></thead>
