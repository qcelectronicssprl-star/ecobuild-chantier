function buildPermChecks(selectedPerms) {
  const wrap = document.getElementById('perm-checks');
  if (!wrap) return;
  wrap.innerHTML = MODULES.map(m => `
    <label class="perm-cb">
      <input type="checkbox" value="${m.id}" ${selectedPerms.includes(m.id)?'checked':''}
        onchange="customizePerms()"/>
      ${m.icon} ${m.label}
    </label>`).join('');
}

function applyRolePreset() {
  const role = document.getElementById('u-role')?.value;
  const preset = ROLE_PRESETS[role];
  if (!preset) return;
  buildPermChecks(preset.perms);
}

function customizePerms() {
  // Passer en mode custom si on modifie manuellement
  const sel = document.getElementById('u-role');
  if (sel && sel.value !== 'custom') sel.value = 'custom';
}

function getCheckedPerms() {
  return [...document.querySelectorAll('#perm-checks input:checked')].map(i=>i.value);
}

function resetUserForm() {
  ['u-nom','u-login','u-pass'].forEach(id=>{ const e=document.getElementById(id); if(e)e.value=''; });
  const r=document.getElementById('u-role'); if(r){r.value='chef'; applyRolePreset();}
}

function addUser() {
  const nom   = document.getElementById('u-nom').value.trim();
  const login = document.getElementById('u-login').value.trim();
  const pass  = document.getElementById('u-pass').value;
  const role  = document.getElementById('u-role').value;
  if (!nom||!login||!pass) { alert('Remplissez nom, identifiant et mot de passe.'); return; }
  if (AUTH.users.find(u=>u.login===login)) { alert('Cet identifiant existe déjà.'); return; }
  const perms = getCheckedPerms();
  AUTH.users.push({
    id:'u'+Date.now(), nom, login, pass,
    role, perms, createdAt:today(), lastLogin:null, active:true
  });
  saveAuth();
  resetUserForm();
  renderAdmin();
  alert(`Utilisateur "${nom}" créé avec succès.`);
}

function deleteUser(id) {
  if (id==='u0'||AUTH.users.find(u=>u.id===id)?.login==='admin') { alert('Impossible de supprimer l\'administrateur principal.'); return; }
  if (!confirm('Supprimer cet utilisateur ?')) return;
  AUTH.users = AUTH.users.filter(u=>u.id!==id);
  saveAuth(); renderAdmin();
}

function toggleUser(id) {
  const u = AUTH.users.find(u=>u.id===id);
  if (!u) return;
  if (u.login==='admin') { alert('Impossible de désactiver l\'administrateur principal.'); return; }
  u.active = !u.active;
  saveAuth(); renderAdmin();
}

function updateUserPerms(id) {
  const u = AUTH.users.find(u=>u.id===id);
  if (!u) return;
  const newPerms = [];
  MODULES.forEach(m=>{
    const cb = document.getElementById('perm-'+id+'-'+m.id);
    if (cb&&cb.checked) newPerms.push(m.id);
  });
  u.perms = newPerms;
  // Mettre à jour rôle si changement
  const roleSel = document.getElementById('role-sel-'+id);
  if (roleSel) u.role = roleSel.value;
  saveAuth();
  // Si c'est l'utilisateur connecté, mettre à jour ses perms en live
  if (currentUser && currentUser.id === id) {
    currentUser.perms = newPerms;
    currentUser.role  = u.role;
    applyAccess();
  }
  alert('Permissions mises à jour.');
}

function changePassword() {
  const uid  = document.getElementById('chg-user').value;
