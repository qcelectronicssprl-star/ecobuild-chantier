        <td class="tbl-num" style="color:var(--rouge);font-weight:600">${fmtN(dep)}</td>
        <td class="tbl-num" style="font-weight:700;color:${solde>=0?'var(--eco)':'var(--rouge)'}">${solde>=0?'+':''}${fmtN(solde)}</td>
      </tr>`;
    }).join('');
    // Ligne total
    const totDComp=DB.depots.filter(d=>d.type==='compte').reduce((s,d)=>s+d.montant,0);
    const totDCash=DB.depots.filter(d=>d.type==='cash').reduce((s,d)=>s+d.montant,0);
    const totDep=DB.depenses.reduce((s,d)=>s+d.montant,0);
    const soldeGlob=totDComp+totDCash-totDep;
    tb.innerHTML+=`<tr style="background:var(--eco-xl);font-weight:700">
      <td>TOTAL</td>
      <td class="tbl-num" style="color:var(--bleu)">${fmtN(totDComp)}</td>
      <td class="tbl-num" style="color:var(--ocre)">${fmtN(totDCash)}</td>
      <td class="tbl-num">${fmtN(totDComp+totDCash)}</td>
      <td class="tbl-num" style="color:var(--rouge)">${fmtN(totDep)}</td>
      <td class="tbl-num" style="color:${soldeGlob>=0?'var(--eco)':'var(--rouge)'}">${soldeGlob>=0?'+':''}${fmtN(soldeGlob)}</td>
    </tr>`;
  }
}

