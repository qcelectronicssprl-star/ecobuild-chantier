function renderDashboard(){
  const projetsActifs=DB.projets.filter(p=>p.statut==='En cours').length;
  const budgetTotal=DB.projets.reduce((s,p)=>s+p.budgetTotal,0);
  const depTotal=DB.depenses.reduce((s,d)=>s+d.montant,0);
  const reste=budgetTotal-depTotal;
  const depasses=DB.projets.filter(p=>{
    const dep=DB.depenses.filter(d=>d.projetId===p.id).reduce((s,d)=>s+d.montant,0);
    return dep>p.budgetTotal;
  }).length;
  document.getElementById('d-projets').textContent=projetsActifs;
  document.getElementById('d-budget').textContent=fmtN(budgetTotal);
  document.getElementById('d-depenses').textContent=fmtN(depTotal);
  document.getElementById('d-reste').textContent=fmtN(reste);
  document.getElementById('d-depasse').textContent=depasses;

  // Projets en cours
  const pl=document.getElementById('d-projets-list');
  const enc=DB.projets.filter(p=>p.statut==='En cours').slice(0,4);
  if(!enc.length){pl.innerHTML='<p style="color:var(--gris-l);font-size:.8rem">Aucun projet en cours.</p>';}
  else pl.innerHTML=enc.map(p=>{
    const dep=DB.depenses.filter(d=>d.projetId===p.id).reduce((s,d)=>s+d.montant,0);
    const pct=p.budgetTotal?Math.min(100,Math.round(dep/p.budgetTotal*100)):0;
    const over=dep>p.budgetTotal;
    return `<div style="padding:8px 0;border-bottom:1px solid var(--border)">
      <div style="display:flex;justify-content:space-between;font-size:.8rem;margin-bottom:4px">
        <strong>${p.ref} — ${p.nom}</strong>
        <span style="color:${over?'var(--rouge)':'var(--eco)'};font-weight:700">${pct}%</span>
      </div>
      <div class="prog-wrap"><div class="prog-fill ${over?'pf-rouge':'pf-eco'}" style="width:${pct}%"></div></div>
      <div style="font-size:.7rem;color:var(--gris-l);margin-top:3px">${fmtN(dep)} / ${fmtN(p.budgetTotal)} FCFA</div>
    </div>`;
  }).join('');

  // Dernières dépenses
  const dl=document.getElementById('d-dep-list');
  const deps=[...DB.depenses].reverse().slice(0,5);
  if(!deps.length){dl.innerHTML='<p style="color:var(--gris-l);font-size:.8rem">Aucune dépense.</p>';}
  else dl.innerHTML=deps.map(d=>`
    <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border);font-size:.78rem">
      <div><span class="badge ${CATS[d.cat]?.cls||''}">${CATS[d.cat]?.label||d.cat}</span> <span style="margin-left:6px">${d.label}</span></div>
      <strong>${fmtN(d.montant)} FCFA</strong>
    </div>`).join('');

  // Alertes dépassement
  const al=document.getElementById('d-alertes');
  const deps2=DB.projets.filter(p=>{const d=DB.depenses.filter(x=>x.projetId===p.id).reduce((s,x)=>s+x.montant,0);return d>p.budgetTotal&&p.budgetTotal>0;});
  if(!deps2.length){al.innerHTML='<p style="color:var(--gris-l);font-size:.8rem">✅ Aucun dépassement budgétaire.</p>';}
  else al.innerHTML=deps2.map(p=>{
    const d=DB.depenses.filter(x=>x.projetId===p.id).reduce((s,x)=>s+x.montant,0);
    const ecart=d-p.budgetTotal;
    return `<div style="padding:8px;background:var(--rouge-l);border-radius:5px;margin-bottom:6px;font-size:.78rem">
      <strong style="color:var(--rouge)">${p.ref} — ${p.nom}</strong><br>
      Dépassement : <strong style="color:var(--rouge)">+${fmtN(ecart)} FCFA</strong> (${fmtN(d)} / budget ${fmtN(p.budgetTotal)})
    </div>`;
  }).join('');

  // Widget dépôts trésorerie sur dashboard
  const depTotCompte=DB.depots.filter(d=>d.type==='compte').reduce((s,d)=>s+d.montant,0);
  const depTotCash=DB.depots.filter(d=>d.type==='cash').reduce((s,d)=>s+d.montant,0);
  const solde=(depTotCompte+depTotCash)-depTotal;
  // Injecter dans le dashboard si le widget existe
  const wTr=document.getElementById('d-tresorerie');
  if(wTr) wTr.innerHTML=`
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
      <div style="background:var(--bleu-l);border-radius:6px;padding:12px;text-align:center">
        <div style="font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-weight:700;color:var(--bleu)">${fmtN(depTotCompte)}</div>
        <div style="font-size:.65rem;color:var(--bleu);margin-top:3px;text-transform:uppercase;letter-spacing:.5px">🏦 Compte bancaire</div>
      </div>
      <div style="background:var(--ocre-pale);border-radius:6px;padding:12px;text-align:center">
        <div style="font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-weight:700;color:var(--ocre)">${fmtN(depTotCash)}</div>
        <div style="font-size:.65rem;color:var(--ocre);margin-top:3px;text-transform:uppercase;letter-spacing:.5px">💵 Cash</div>
      </div>
      <div style="background:${solde>=0?'var(--eco-xl)':'var(--rouge-l)'};border-radius:6px;padding:12px;text-align:center">
        <div style="font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-weight:700;color:${solde>=0?'var(--eco)':'var(--rouge)'}">${solde>=0?'+':''}${fmtN(solde)}</div>
        <div style="font-size:.65rem;color:${solde>=0?'var(--eco)':'var(--rouge)'};margin-top:3px;text-transform:uppercase;letter-spacing:.5px">Solde trésorerie</div>
      </div>
    </div>`;
  const catEl=document.getElementById('d-categories');
  const catTotaux={mo:0,mat:0,ss:0,eq:0,fg:0};
  DB.depenses.forEach(d=>{if(catTotaux[d.cat]!==undefined)catTotaux[d.cat]+=d.montant;});
  const total=Object.values(catTotaux).reduce((a,b)=>a+b,0)||1;
  // Graphiques — rendu différé pour laisser le DOM se stabiliser
  setTimeout(renderCharts, 80);
}

