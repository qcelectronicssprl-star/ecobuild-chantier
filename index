// Helpers canvas
function ctx2(id) {
  const c = document.getElementById(id);
  if (!c) return null;
  const wrap = c.parentElement;
  c.width  = wrap.clientWidth  || 400;
  c.height = wrap.clientHeight || 220;
  const cx = c.getContext('2d');
  cx.clearRect(0, 0, c.width, c.height);
  return { cx, W:c.width, H:c.height };
}

function fmtShort(n) {
  if (Math.abs(n) >= 1e6) return (n/1e6).toFixed(1)+'M';
  if (Math.abs(n) >= 1e3) return (n/1e3).toFixed(0)+'k';
  return Math.round(n).toString();
}

// ── Graphique en barres groupées ──────────────────
function drawBarChart(id, labels, datasets, opts) {
  const g = ctx2(id);
  if (!g) return;
  const { cx, W, H } = g;
  opts = opts||{};
  const pad = { top:20, right:16, bottom:50, left:60 };
  const chartW = W - pad.left - pad.right;
  const chartH = H - pad.top  - pad.bottom;
  const nGroups = labels.length;
  const nSets   = datasets.length;
  if (!nGroups) { drawEmpty(cx, W, H, 'Aucune donnée'); return; }

  const allVals = datasets.flatMap(d=>d.data);
  const maxV = Math.max(...allVals, 1);
  const minV = opts.allowNeg ? Math.min(...allVals, 0) : 0;
  const range = maxV - minV || 1;

  // Grille
  cx.strokeStyle = '#E5E7EB'; cx.lineWidth = 1;
  const nLines = 4;
  for (let i=0; i<=nLines; i++) {
    const y = pad.top + chartH - (i/nLines)*chartH;
    cx.beginPath(); cx.moveTo(pad.left, y); cx.lineTo(pad.left+chartW, y); cx.stroke();
    const val = minV + (i/nLines)*range;
    cx.fillStyle='#9CA3AF'; cx.font='10px Inter,sans-serif'; cx.textAlign='right';
    cx.fillText(fmtShort(val), pad.left-4, y+3);
  }

  // Zéro si négatif possible
  if (opts.allowNeg) {
    const y0 = pad.top + chartH - (0-minV)/range*chartH;
    cx.strokeStyle='#374151'; cx.lineWidth=1.5;
    cx.beginPath(); cx.moveTo(pad.left,y0); cx.lineTo(pad.left+chartW,y0); cx.stroke();
    cx.lineWidth=1;
  }

  const groupW = chartW / nGroups;
  const barW   = Math.max(4, (groupW / (nSets+1)) * 0.85);
  const gap    = (groupW - barW*nSets) / (nSets+1);

  datasets.forEach((ds, si) => {
    cx.fillStyle = ds.color || PROJ_COLORS[si % PROJ_COLORS.length];
    ds.data.forEach((val, gi) => {
      const x  = pad.left + gi*groupW + gap + si*(barW+gap/nSets);
      const y0 = pad.top + chartH - (0-minV)/range*chartH;
      const bH = Math.abs(val-minV)/range*chartH;
      const y  = val >= 0 ? y0-bH : y0;
      cx.beginPath();
      const r = Math.min(3, barW/3);
      if (val>=0) {
        cx.moveTo(x+r,y); cx.lineTo(x+barW-r,y);
        cx.quadraticCurveTo(x+barW,y,x+barW,y+r);
        cx.lineTo(x+barW,y+bH); cx.lineTo(x,y+bH);
        cx.lineTo(x,y+r); cx.quadraticCurveTo(x,y,x+r,y);
      } else {
        cx.rect(x,y,barW,bH);
      }
      cx.fill();
      // Valeur au-dessus si place
      if (bH > 14) {
        cx.fillStyle='rgba(0,0,0,0.6)'; cx.font='bold 9px Inter,sans-serif'; cx.textAlign='center';
        cx.fillText(fmtShort(val), x+barW/2, val>=0?y-3:y+bH+10);
        cx.fillStyle = ds.color || PROJ_COLORS[si];
      }
    });
  });

  // Labels axe X
  cx.fillStyle='#4B5563'; cx.font='10px Inter,sans-serif'; cx.textAlign='center';
  labels.forEach((lbl, gi) => {
    const x = pad.left + gi*groupW + groupW/2;
    const short = lbl.length>10 ? lbl.slice(0,9)+'…' : lbl;
    cx.fillText(short, x, H - pad.bottom + 14);
  });
}

// ── Graphique barres horizontales ─────────────────
function drawHBarChart(id, labels, vals, colors, opts) {
  const g = ctx2(id);
  if (!g) return;
  const { cx, W, H } = g;
  opts = opts||{};
  const pad = { top:10, right:70, bottom:16, left:110 };
  const chartW = W - pad.left - pad.right;
  const chartH = H - pad.top  - pad.bottom;
  if (!labels.length) { drawEmpty(cx, W, H, 'Aucune donnée'); return; }

  const maxV = Math.max(...vals.map(Math.abs), 1);
  const barH = Math.max(8, chartH / labels.length - 6);

  labels.forEach((lbl, i) => {
    const y   = pad.top + i*(chartH/labels.length) + (chartH/labels.length - barH)/2;
    const val = vals[i];
    const col = colors ? colors[i] : (val>=0 ? GCOLS.eco : GCOLS.rouge);
    const bW  = Math.abs(val)/maxV * chartW * (val>=0?1:0.5);
    const x   = val>=0 ? pad.left : pad.left + chartW/2 - bW;

    // Barre
    cx.fillStyle = col;
    cx.beginPath();
    const r = Math.min(3, barH/3);
    cx.roundRect ? cx.roundRect(x, y, bW, barH, r) : cx.rect(x, y, bW, barH);
    cx.fill();

    // Label gauche
    cx.fillStyle='#374151'; cx.font='bold 10px Inter,sans-serif'; cx.textAlign='right';
    const short = lbl.length>14 ? lbl.slice(0,13)+'…' : lbl;
    cx.fillText(short, pad.left-6, y+barH/2+3);

    // Valeur droite
    cx.fillStyle=col; cx.font='bold 10px Inter,sans-serif'; cx.textAlign='left';
    cx.fillText(fmtShort(val)+' FCFA', x+bW+4, y+barH/2+3);
  });
}

// ── Donut ─────────────────────────────────────────
function drawDonut(id, labels, vals, colors) {
  const g = ctx2(id);
  if (!g) return;
  const { cx, W, H } = g;
  const total = vals.reduce((a,b)=>a+b,0);
  if (!total) { drawEmpty(cx, W, H, 'Aucune dépense'); return; }

  const cx0 = W/2, cy0 = H/2;
  const R = Math.min(W, H)/2 - 10;
  const r = R * 0.55;
  let angle = -Math.PI/2;

  vals.forEach((v, i) => {
    const sweep = (v/total) * 2 * Math.PI;
    cx.beginPath();
    cx.moveTo(cx0 + r*Math.cos(angle), cy0 + r*Math.sin(angle));
    cx.arc(cx0, cy0, R, angle, angle+sweep);
    cx.arc(cx0, cy0, r, angle+sweep, angle, true);
    cx.closePath();
    cx.fillStyle = colors[i];
    cx.fill();
    cx.strokeStyle='#fff'; cx.lineWidth=2; cx.stroke();

    // Pourcentage si slice assez grande
    if (sweep > 0.25) {
      const mid = angle + sweep/2;
      const tx = cx0 + (r+(R-r)/2)*Math.cos(mid);
      const ty = cy0 + (r+(R-r)/2)*Math.sin(mid);
      cx.fillStyle='#fff'; cx.font='bold 10px Inter,sans-serif'; cx.textAlign='center';
      cx.fillText(Math.round(v/total*100)+'%', tx, ty+4);
    }
    angle += sweep;
  });

  // Centre : total
  cx.fillStyle='#1F2937'; cx.font='bold 12px Cormorant Garamond,serif'; cx.textAlign='center';
  cx.fillText(fmtShort(total), cx0, cy0-2);
  cx.fillStyle='#9CA3AF'; cx.font='9px Inter,sans-serif';
  cx.fillText('FCFA', cx0, cy0+11);
}

// ── Graphique aires (ligne + remplissage) ─────────
function drawAreaChart(id, labels, datasets) {
  const g = ctx2(id);
  if (!g) return;
  const { cx, W, H } = g;
  const pad = { top:20, right:16, bottom:40, left:58 };
  const chartW = W - pad.left - pad.right;
  const chartH = H - pad.top  - pad.bottom;
  if (!labels.length) { drawEmpty(cx, W, H, 'Aucune donnée'); return; }

  const allVals = datasets.flatMap(d=>d.data);
  const maxV = Math.max(...allVals, 1);
  const step = chartW / Math.max(labels.length-1, 1);

  // Grille
  cx.strokeStyle='#E5E7EB'; cx.lineWidth=1;
  for (let i=0; i<=4; i++) {
    const y = pad.top + chartH - (i/4)*chartH;
    cx.beginPath(); cx.moveTo(pad.left,y); cx.lineTo(pad.left+chartW,y); cx.stroke();
    cx.fillStyle='#9CA3AF'; cx.font='9px Inter,sans-serif'; cx.textAlign='right';
    cx.fillText(fmtShort(maxV*i/4), pad.left-4, y+3);
  }

  datasets.forEach(ds => {
    const pts = ds.data.map((v,i)=>({ x: pad.left+i*step, y: pad.top+chartH-(v/maxV)*chartH }));

    // Aire
    cx.beginPath();
    cx.moveTo(pts[0].x, pad.top+chartH);
    pts.forEach(p => cx.lineTo(p.x, p.y));
    cx.lineTo(pts[pts.length-1].x, pad.top+chartH);
    cx.closePath();
    cx.fillStyle = ds.color.replace(')',',0.15)').replace('rgb','rgba').replace('#',
      'rgba('+parseInt(ds.color.slice(1,3),16)+','+parseInt(ds.color.slice(3,5),16)+','+parseInt(ds.color.slice(5,7),16)+',');
    // Simplifié : fillStyle semi-transparent
    cx.globalAlpha=0.18; cx.fillStyle=ds.color; cx.fill(); cx.globalAlpha=1;

    // Ligne
    cx.beginPath();
    pts.forEach((p,i) => i===0 ? cx.moveTo(p.x,p.y) : cx.lineTo(p.x,p.y));
    cx.strokeStyle=ds.color; cx.lineWidth=2.5; cx.lineJoin='round'; cx.stroke();

    // Points
    pts.forEach(p => {
      cx.beginPath(); cx.arc(p.x,p.y,4,0,2*Math.PI);
      cx.fillStyle='#fff'; cx.fill();
      cx.strokeStyle=ds.color; cx.lineWidth=2; cx.stroke();
    });
  });

  // Labels X
  cx.fillStyle='#6B7280'; cx.font='9px Inter,sans-serif'; cx.textAlign='center';
  labels.forEach((lbl, i) => {
    cx.fillText(lbl, pad.left + i*step, H - pad.bottom + 12);
  });
}

// ── Barres empilées (100% ou absolues) ────────────
function drawStackedBar(id, labels, datasets, pct) {
  const g = ctx2(id);
  if (!g) return;
  const { cx, W, H } = g;
  const pad = { top:20, right:16, bottom:50, left:58 };
  const chartW = W - pad.left - pad.right;
  const chartH = H - pad.top  - pad.bottom;
  if (!labels.length) { drawEmpty(cx, W, H, 'Aucune donnée'); return; }

  // Totaux par groupe
  const totals = labels.map((_,gi) => datasets.reduce((s,ds)=>s+(ds.data[gi]||0),0));
  const maxV   = pct ? 100 : Math.max(...totals, 1);

  // Grille
  cx.strokeStyle='#E5E7EB'; cx.lineWidth=1;
  for (let i=0; i<=4; i++) {
    const y = pad.top + chartH - (i/4)*chartH;
    cx.beginPath(); cx.moveTo(pad.left,y); cx.lineTo(pad.left+chartW,y); cx.stroke();
    cx.fillStyle='#9CA3AF'; cx.font='9px Inter,sans-serif'; cx.textAlign='right';
    cx.fillText(pct ? (i*25)+'%' : fmtShort(maxV*i/4), pad.left-4, y+3);
  }

  const barW  = Math.max(8, (chartW/labels.length) * 0.6);
  const grpW  = chartW/labels.length;

  labels.forEach((lbl, gi) => {
    const total = totals[gi] || 1;
    let yBottom = pad.top + chartH;
    const x = pad.left + gi*grpW + (grpW-barW)/2;

    datasets.forEach((ds, si) => {
      const raw = ds.data[gi] || 0;
      const v   = pct ? raw/total*100 : raw;
      const bH  = (v/maxV)*chartH;
      const y   = yBottom - bH;
      cx.fillStyle = ds.color;
      const r = si===datasets.length-1 ? Math.min(3,barW/3) : 0;
      cx.beginPath();
      if (r > 0) {
        cx.moveTo(x+r,y); cx.lineTo(x+barW-r,y);
        cx.quadraticCurveTo(x+barW,y,x+barW,y+r);
        cx.lineTo(x+barW,yBottom); cx.lineTo(x,yBottom);
        cx.lineTo(x,y+r); cx.quadraticCurveTo(x,y,x+r,y);
      } else {
        cx.rect(x,y,barW,bH);
      }
      cx.fill();
      yBottom = y;
    });

    // Label X
    cx.fillStyle='#4B5563'; cx.font='9px Inter,sans-serif'; cx.textAlign='center';
    const short = lbl.length>8 ? lbl.slice(0,7)+'…' : lbl;
    cx.fillText(short, x+barW/2, H - pad.bottom + 13);
  });
}

function drawEmpty(cx, W, H, msg) {
  cx.fillStyle='#D1D5DB'; cx.font='13px Inter,sans-serif'; cx.textAlign='center';
  cx.fillText('📭', W/2, H/2-8);
  cx.fillText(msg, W/2, H/2+14);
}

function makeLegend(elId, items) {
  const el = document.getElementById(elId);
  if (!el) return;
  el.innerHTML = items.map(it=>
    `<div class="leg-item"><div class="leg-dot" style="background:${it.color}"></div>${it.label}</div>`
  ).join('');
}

// ── Rendu de tous les graphiques ──────────────────
function renderCharts() {
  const projets  = DB.projets;
  const depenses = DB.depenses;
  const depots   = DB.depots;

  // ─ 1. Budget vs Dépenses par projet ─
  if (projets.length) {
    const labels = projets.map(p => p.ref||p.nom.slice(0,8));
    if (chartTabState.bvr === 'abs') {
      const budData = projets.map(p => p.budgetTotal);
      const depData = projets.map(p => depenses.filter(d=>d.projetId===p.id).reduce((s,d)=>s+d.montant,0));
      drawBarChart('chart-bvr', labels, [
        { label:'Budget prévu', data:budData, color:GCOLS.ocre },
        { label:'Dépensé',      data:depData, color:GCOLS.eco2 },
      ]);
      makeLegend('leg-bvr',[{color:GCOLS.ocre,label:'Budget prévu'},{color:GCOLS.eco2,label:'Dépensé'}]);
    } else {
      const pctData = projets.map(p => {
        const d = depenses.filter(x=>x.projetId===p.id).reduce((s,x)=>s+x.montant,0);
        return p.budgetTotal ? Math.round(d/p.budgetTotal*100) : 0;
      });
      drawBarChart('chart-bvr', labels, [
        { label:'% Consommé', data:pctData, color:GCOLS.eco },
      ]);
      makeLegend('leg-bvr',[{color:GCOLS.eco,label:'% Consommé'}]);
    }
  } else {
    const g=ctx2('chart-bvr'); if(g) drawEmpty(g.cx,g.W,g.H,'Créez des projets');
  }

  // ─ 2. Donut dépenses par catégorie ─
  const catTotaux = Object.entries(CATS).map(([k,c])=>({
    label:c.label,
    val:depenses.filter(d=>d.cat===k).reduce((s,d)=>s+d.montant,0),
    color:CAT_COLORS[k]
  })).filter(x=>x.val>0);
  if (catTotaux.length) {
    drawDonut('chart-donut', catTotaux.map(x=>x.label), catTotaux.map(x=>x.val), catTotaux.map(x=>x.color));
    makeLegend('leg-donut', catTotaux.map(x=>({color:x.color,label:x.label})));
  } else {
    const g=ctx2('chart-donut'); if(g) drawEmpty(g.cx,g.W,g.H,'Aucune dépense');
  }

  // ─ 3. Entrées & Sorties mensuelles ─
  const nbMois = chartTabState.month === '12' ? 12 : 6;
  const moisLabels = [];
  const moisDep = [], moisEnt = [];
  const now = new Date();
  for (let i=nbMois-1; i>=0; i--) {
    const d = new Date(now.getFullYear(), now.getMonth()-i, 1);
    const key = d.toISOString().slice(0,7);
    moisLabels.push(key.slice(2));
    moisDep.push(depenses.filter(x=>x.date?.startsWith(key)).reduce((s,x)=>s+x.montant,0));
    moisEnt.push(depots.filter(x=>x.date?.startsWith(key)).reduce((s,x)=>s+x.montant,0));
  }
  drawAreaChart('chart-monthly', moisLabels, [
    { label:'Dépôts (entrées)', data:moisEnt, color:GCOLS.eco  },
    { label:'Dépenses (sorties)', data:moisDep, color:GCOLS.rouge },
  ]);
  makeLegend('leg-monthly',[
    {color:GCOLS.eco,  label:'Dépôts (entrées)'},
    {color:GCOLS.rouge,label:'Dépenses (sorties)'},
  ]);

  // ─ 4. Dépenses par catégorie & projet (empilées) ─
  if (projets.length) {
    const labels4 = projets.map(p => p.ref||p.nom.slice(0,8));
    const datasets4 = Object.entries(CATS).map(([k,c])=>({
      label:c.label,
      data:projets.map(p => depenses.filter(d=>d.projetId===p.id&&d.cat===k).reduce((s,d)=>s+d.montant,0)),
      color:CAT_COLORS[k],
    })).filter(ds=>ds.data.some(v=>v>0));
    if (datasets4.length) {
      drawStackedBar('chart-stack', labels4, datasets4, chartTabState.stack==='pct');
      makeLegend('leg-stack', datasets4.map(d=>({color:d.color,label:d.label})));
    } else {
      const g=ctx2('chart-stack'); if(g) drawEmpty(g.cx,g.W,g.H,'Aucune dépense saisie');
    }
  } else {
    const g=ctx2('chart-stack'); if(g) drawEmpty(g.cx,g.W,g.H,'Créez des projets');
  }

  // ─ 5. Solde trésorerie par projet (horizontal) ─
  if (projets.length) {
    const labels5  = projets.map(p => p.ref||p.nom.slice(0,12));
    const vals5    = projets.map(p => {
      const ent = depots.filter(d=>d.projetId===p.id).reduce((s,d)=>s+d.montant,0);
      const dep = depenses.filter(d=>d.projetId===p.id).reduce((s,d)=>s+d.montant,0);
      return ent - dep;
    });
    const cols5 = vals5.map(v => v>=0 ? GCOLS.eco : GCOLS.rouge);
    drawHBarChart('chart-solde', labels5, vals5, cols5, {allowNeg:true});
    const hasDef = vals5.some(v=>v<0);
    makeLegend('leg-solde',[
      {color:GCOLS.eco,  label:'Solde positif'},
      ...(hasDef?[{color:GCOLS.rouge,label:'Déficit'}]:[]),
    ]);
  } else {
    const g=ctx2('chart-solde'); if(g) drawEmpty(g.cx,g.W,g.H,'Créez des projets');
  }
}

