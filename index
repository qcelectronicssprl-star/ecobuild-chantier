function addDepense(){
  const projetId=document.getElementById('dep-projet').value;
  if(!projetId){alert('Sélectionnez un projet.');return;}
  const label=document.getElementById('dep-label').value.trim();
  if(!label){alert('Entrez une désignation.');return;}
  const qte=parseFloat(document.getElementById('dep-qte').value)||0;
  const pu=parseFloat(document.getElementById('dep-pu').value)||0;
  const fourId=document.getElementById('dep-four').value;
  DB.depenses.push({
    id:uid(),projetId,cat:document.getElementById('dep-cat').value,
    date:document.getElementById('dep-date').value||today(),
    fourId,fourNom:fourById(fourId)?.nom||document.getElementById('dep-four').options[document.getElementById('dep-four').selectedIndex]?.text||'—',
    label,qte,pu,montant:qte*pu,
    mode:document.getElementById('dep-mode').value,
    piece:document.getElementById('dep-piece').value,
    obs:document.getElementById('dep-obs').value,
    datec:today()
  });
  ['dep-label','dep-piece','dep-obs'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('dep-qte').value='1';
  document.getElementById('dep-pu').value='0';
  document.getElementById('dep-preview').textContent='0 FCFA';
  save();renderDepenses();updateBadges();
  if(currentView==='dashboard') setTimeout(renderCharts,80);
}

function renderDepenses(){
  const filtProjet=document.getElementById('f-projet')?.value||'';
  const filtCat=document.getElementById('f-cat')?.value||'';
  const filtDu=document.getElementById('f-du')?.value||'';
  const filtAu=document.getElementById('f-au')?.value||'';
  let deps=[...DB.depenses].reverse();
  if(filtProjet) deps=deps.filter(d=>d.projetId===filtProjet);
  if(filtCat)    deps=deps.filter(d=>d.cat===filtCat);
  if(filtDu)     deps=deps.filter(d=>d.date>=filtDu);
  if(filtAu)     deps=deps.filter(d=>d.date<=filtAu);
  const total=deps.reduce((s,d)=>s+d.montant,0);
  document.getElementById('dep-total').textContent=fmtN(total)+' FCFA';
  const tb=document.getElementById('dep-tbody');
  if(!deps.length){tb.innerHTML='<tr><td colspan="10" style="text-align:center;color:var(--gris-l);padding:24px">Aucune dépense</td></tr>';return;}
  tb.innerHTML=deps.map(d=>{
    const p=projetById(d.projetId);
    return `<tr>
      <td>${d.date}</td>
      <td><strong>${p?.ref||'—'}</strong><br><small style="color:var(--gris-l)">${p?.nom||'—'}</small></td>
      <td><span class="badge ${CATS[d.cat]?.cls||''}">${CATS[d.cat]?.label||d.cat}</span></td>
      <td>${d.label}</td>
      <td class="tbl-num">${fmtN(d.qte)}</td>
      <td class="tbl-num">${fmtN(d.pu)}</td>
      <td class="tbl-num" style="font-weight:700">${fmtN(d.montant)}</td>
      <td>${d.mode}</td>
      <td>${d.piece||'—'}</td>
      <td class="actions no-print">
        <button class="btn btn-xs btn-bleu" onclick="editDep('${d.id}')">✏️</button>
        <button class="btn btn-xs btn-sec" onclick="deleteDep('${d.id}')">🗑</button>
      </td>
    </tr>`;
  }).join('');
}

function deleteDep(id){if(confirm('Supprimer cette dépense ?')){DB.depenses=DB.depenses.filter(d=>d.id!==id);save();renderDepenses();updateBadges();}}

