function isAdmin() { return currentUser?.role === 'admin'; }

function hasAccess(module) {
  if (!currentUser) return false;
  if (isAdmin()) return true;
  return (currentUser.perms||[]).includes(module);
}

function applyAccess() {
  if (!currentUser) return;

  // Bandeau utilisateur sidebar
  document.getElementById('user-avatar').textContent = (currentUser.nom||'?')[0].toUpperCase();
  document.getElementById('user-name').textContent   = currentUser.nom;
  document.getElementById('user-role').textContent   = ROLE_PRESETS[currentUser.role]?.label || currentUser.role;

  // Afficher/masquer boutons nav selon permissions
  const navMap = {
    'dashboard':'go(\'dashboard\')', 'projets':'go(\'projets\')',
    'depenses':'go(\'depenses\')',   'budget':'go(\'budget\')',
    'personnel':'go(\'personnel\')', 'fournisseurs':'go(\'fournisseurs\')',
    'depots':'go(\'depots\')',       'rapports':'go(\'rapports\')',
  };
  document.querySelectorAll('.nav-btn').forEach(btn => {
    const oc = btn.getAttribute('onclick')||'';
    for (const [mod, pat] of Object.entries(navMap)) {
      if (oc.includes("'"+mod+"'")) {
        btn.style.display = hasAccess(mod) ? '' : 'none';
      }
    }
    // Export Excel
    if (oc.includes('exportExcel()')) {
      btn.style.display = hasAccess('export') ? '' : 'none';
    }
  });

  // Admin : afficher section admin
  const adminGroup = document.getElementById('nav-admin-group');
  const adminBtn   = document.getElementById('nav-admin-btn');
  if (isAdmin()) {
    adminGroup.style.display = '';
    adminBtn.style.display   = '';
    // Ajouter admin dans META si absent
    if (!META.admin) META.admin = { title:'Accès & Utilisateurs', badge:'🔑 Administration' };
  }

  // Bouton Export topbar
  const topExport = document.querySelector('.tb-right .btn-ocre');
  if (topExport) topExport.style.display = hasAccess('export') ? '' : 'none';

  // Aller sur dashboard par défaut
  if (hasAccess('dashboard')) go('dashboard');
  else {
    // Aller sur le premier module accessible
    const first = MODULES.find(m => hasAccess(m.id));
    if (first) go(first.id);
  }
}

// Protège go() — empêche d'accéder à un module non autorisé
const _go_orig = go;
go = function(name) {
  if (name === 'admin') {
    if (!isAdmin()) { alert('Accès réservé à l\'administrateur.'); return; }
    _go_orig(name);
    renderAdmin();
    return;
  }
  if (!hasAccess(name) && name !== 'admin') {
    // Afficher overlay verrou sur la vue
    _go_orig(name);
    showLockOverlay(name);
    return;
  }
  _go_orig(name);
};

function showLockOverlay(name) {
  const view = document.getElementById('view-'+name);
  if (!view) return;
  // Retirer overlay existant
  view.querySelectorAll('.lock-overlay').forEach(e=>e.remove());
  const ov = document.createElement('div');
  ov.className = 'lock-overlay';
  ov.innerHTML = `<div class="lock-icon">🔒</div><p>Accès non autorisé</p><p style="font-size:.72rem;opacity:.7;margin-top:4px">Contactez l'administrateur</p>`;
  view.style.position='relative';
  view.appendChild(ov);
}

