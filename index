function finishInit() {
  // Initialisation DOM commune (après chargement des données)
  refreshSelects();
  updateBadges();
  document.getElementById('sb-date').textContent =
    new Date().toLocaleDateString('fr-FR',{weekday:'short',day:'2-digit',month:'long',year:'numeric'});
  document.getElementById('dep-date').value = today();
  document.getElementById('dc-date').value  = today();
  document.getElementById('dh-date').value  = today();
  buildPermChecks(ROLE_PRESETS['chef'].perms);
  applyRolePreset();

  // Restaurer la session en cours
  const savedUid = AUTH.currentUser;
  if (savedUid) {
    const savedUser = AUTH.users.find(u => u.id === savedUid && u.active);
    if (savedUser) {
      currentUser = savedUser;
      document.getElementById('login-screen').style.display = 'none';
      applyAccess();
      go('dashboard');
    }
  }

  // Touche Entrée sur le champ login
  document.getElementById('login-user').addEventListener('keydown', e => {
    if (e.key === 'Enter') document.getElementById('login-pass').focus();
  });

  // Indicateur Firebase dans le pied de la sidebar
  const fbIndicator = document.createElement('div');
  fbIndicator.style.cssText = 'font-size:.6rem;margin-top:4px;padding:3px 8px;border-radius:4px;display:inline-block';
  if (_dbRef) {
    fbIndicator.style.background = '#D1FAE5';
    fbIndicator.style.color      = '#1B4F3A';
    fbIndicator.innerHTML        = '🔥 Firebase connecté — <a href="#" onclick="reconfigureFirebase();return false;" style="color:inherit;font-weight:700">reconfigurer</a>';
  } else {
    fbIndicator.style.background = '#FEF3C7';
    fbIndicator.style.color      = '#92400E';
    fbIndicator.innerHTML        = '⚠️ Mode local — <a href="#" onclick="location.reload();return false;" style="color:inherit;font-weight:700">configurer Firebase</a>';
  }
  const sbFoot = document.querySelector('.sb-foot');
  if (sbFoot) sbFoot.appendChild(fbIndicator);
}

async function initApp() {
  // 1. Charger la config Firebase depuis localStorage
  loadFbConfig();

  // 2. Si pas de config → afficher l'écran de configuration
  if (!isFirebaseConfigured()) {
    document.getElementById('firebase-setup').style.display = 'flex';
    // Fallback : charger depuis localStorage pour usage local éventuel
    load();
    loadAuthLocal();
    ensureAdminUser();
    showStorageWarning();
    finishInit();
    return;
  }

  // 3. Initialiser Firebase
  const fbOK = initFirebase();
  if (!fbOK) {
    // Erreur d'init (mauvaise config ?) — afficher l'écran de reconfiguration
    document.getElementById('firebase-setup').style.display = 'flex';
    load();
    loadAuthLocal();
    ensureAdminUser();
    finishInit();
    return;
  }

  // 4. Charger les données depuis Firebase (async)
  try {
    const [dbSnap, authSnap] = await Promise.all([
      _dbRef.once('value'),
      _authRef.once('value'),
    ]);

    // Données de l'application
    if (dbSnap.exists() && dbSnap.val()) {
      const remoteDB = dbSnap.val();
      // Fusionner les clés pour ne pas perdre une table vide non stockée
      DB.projets      = remoteDB.projets      || [];
      DB.depenses     = remoteDB.depenses     || [];
      DB.personnel    = remoteDB.personnel    || [];
      DB.fournisseurs = remoteDB.fournisseurs || [];
      DB.depots       = remoteDB.depots       || [];
    }

    // Comptes utilisateurs
    if (authSnap.exists() && authSnap.val()) {
      const remoteAuth = authSnap.val();
      if (remoteAuth._v === AUTH_VER) {
        AUTH.users       = remoteAuth.users       || [];
        AUTH.currentUser = remoteAuth.currentUser || null;
      }
    }

    ensureAdminUser();

    // 5. Écouter les changements en temps réel (autres utilisateurs)
    _dbRef.on('value', snap => {
      if (!snap.exists()) return;
      const r = snap.val();
      DB.projets      = r.projets      || [];
      DB.depenses     = r.depenses     || [];
      DB.personnel    = r.personnel    || [];
      DB.fournisseurs = r.fournisseurs || [];
      DB.depots       = r.depots       || [];
      updateBadges();
      refreshSelects();
      // Re-rendre la vue active si ce n'est pas une saisie en cours
      if (currentView && document.activeElement.tagName !== 'INPUT'
                       && document.activeElement.tagName !== 'TEXTAREA'
                       && document.activeElement.tagName !== 'SELECT') {
        go(currentView);
      }
    });

    // Auth en temps réel (pour voir les nouveaux comptes créés par l'admin)
    _authRef.on('value', snap => {
      if (!snap.exists()) return;
      const r = snap.val();
      if (r._v === AUTH_VER) {
        AUTH.users = r.users || [];
        // Ne pas écraser AUTH.currentUser — géré par la session locale
      }
    });

  } catch(e) {
    console.error('Erreur chargement Firebase :', e);
    // Fallback localStorage si Firebase inaccessible
    load();
    loadAuthLocal();
    ensureAdminUser();
    const banner = document.createElement('div');
    banner.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:99999;background:#D97706;color:#fff;text-align:center;padding:8px 16px;font-size:.78rem;font-weight:600';
    banner.innerHTML = '⚠️ Impossible de joindre Firebase — fonctionnement en mode local temporaire. '
      + '<button onclick="location.reload()" style="margin-left:10px;background:rgba(255,255,255,.25);border:none;color:#fff;padding:2px 10px;border-radius:4px;cursor:pointer;font-weight:700">Réessayer</button>';
    document.body.appendChild(banner);
  }

  finishInit();
}

// Lancer l'application
initApp();
</script>
</body>
