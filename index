function loadSheetJS(cb){
  if(window.XLSX){cb();return;}
  const s=document.createElement('script');
  s.src='https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
  s.onload=cb;document.head.appendChild(s);
}

function exportExcelProjet(pid){
  // si pas de pid, prendre celui du select budget
  if(!pid){
    pid=document.getElementById('bud-projet')?.value||
        document.getElementById('f-projet')?.value||'';
  }
  loadSheetJS(()=>{
    const wb=XLSX.utils.book_new();
    const projets=pid?DB.projets.filter(p=>p.id===pid):DB.projets;
    if(!projets.length){alert('Aucun projet sélectionné.');return;}

    projets.forEach(p=>{
      const dep=DB.depenses.filter(d=>d.projetId===p.id);

      // ── Feuille 1 : Budget vs Réel ──
      const depByCat={mo:0,mat:0,ss:0,eq:0,fg:0};
      dep.forEach(d=>{if(depByCat[d.cat]!==undefined)depByCat[d.cat]+=d.montant;});
      const budRows=[
        ['ECOBUILD — RAPPORT BUDGÉTAIRE'],
        [`Projet : ${p.ref} — ${p.nom}`],
        [`Type : ${p.type}   |   Lieu : ${p.lieu||'—'}   |   Maître d'ouvrage : ${p.moa||'—'}`],
        [`Chef de projet : ${p.chef||'—'}   |   Début : ${p.debut||'—'}   |   Fin prévue : ${p.fin||'—'}`],
        [`Édité le : ${new Date().toLocaleDateString('fr-FR')}`],
        [],
        ['Catégorie','Budget prévu (FCFA)','Réel engagé (FCFA)','Écart (FCFA)','% Consommé','Statut'],
        ...Object.entries(CATS).map(([k,c])=>{
          const bud=p.budget[k]||0;const real=depByCat[k]||0;
          const ecart=bud-real;const pct=bud?Math.round(real/bud*100):0;
          return[c.label,bud,real,ecart,pct/100,pct>100?'⚠️ DÉPASSEMENT':pct>80?'⚡ Attention':'✅ OK'];
        }),
        [],
        ['TOTAL',p.budgetTotal,dep.reduce((s,d)=>s+d.montant,0),
          p.budgetTotal-dep.reduce((s,d)=>s+d.montant,0),
          p.budgetTotal?dep.reduce((s,d)=>s+d.montant,0)/p.budgetTotal:0,''],
      ];
      const wsBud=XLSX.utils.aoa_to_sheet(budRows);
      // Formats
      wsBud['!cols']=[{wch:22},{wch:20},{wch:20},{wch:15},{wch:14},{wch:20}];
      wsBud['!merges']=[{s:{r:0,c:0},e:{r:0,c:5}}];
      XLSX.utils.book_append_sheet(wb,wsBud,`Budget_${p.ref}`.slice(0,31));

      // ── Feuille 2 : Dépenses chronologiques ──
      const depRows=[
        ['ECOBUILD — DÉTAIL DES DÉPENSES'],
        [`Projet : ${p.ref} — ${p.nom}`],
        [`Période : ${dep.length?dep[0].date:''} → ${dep.length?dep[dep.length-1].date:''}`],
        [],
        ['Date','Catégorie','Désignation','Fournisseur','Quantité','Prix unitaire','Montant FCFA','Mode paiement','N° Pièce','Observation'],
        ...dep.sort((a,b)=>a.date.localeCompare(b.date)).map(d=>[
          d.date,CATS[d.cat]?.label||d.cat,d.label,d.fourNom||'—',
          d.qte,d.pu,d.montant,d.mode,d.piece||'—',d.obs||'—'
        ]),
        [],
        ['','','','','','TOTAL',dep.reduce((s,d)=>s+d.montant,0),'','',''],
      ];
      const wsDep=XLSX.utils.aoa_to_sheet(depRows);
      wsDep['!cols']=[{wch:12},{wch:16},{wch:28},{wch:20},{wch:10},{wch:14},{wch:16},{wch:14},{wch:14},{wch:20}];
      wsDep['!merges']=[{s:{r:0,c:0},e:{r:0,c:9}}];
      XLSX.utils.book_append_sheet(wb,wsDep,`Depenses_${p.ref}`.slice(0,31));

      // ── Feuille 3 : Dépenses par catégorie ──
      const catRows=[
        ['ECOBUILD — DÉPENSES PAR CATÉGORIE'],
        [`Projet : ${p.ref} — ${p.nom}`],
        [],
      ];
      Object.entries(CATS).forEach(([k,c])=>{
        const catDep=dep.filter(d=>d.cat===k);
        if(!catDep.length)return;
        catRows.push([c.label.toUpperCase(),'','','','','','','']);
        catRows.push(['Date','Désignation','Fournisseur','Qté','PU','Montant','Paiement','Pièce']);
        catDep.forEach(d=>catRows.push([d.date,d.label,d.fourNom||'—',d.qte,d.pu,d.montant,d.mode,d.piece||'—']));
        catRows.push(['','','','','Sous-total',catDep.reduce((s,d)=>s+d.montant,0),'','']);
        catRows.push([]);
      });
      const wsCat=XLSX.utils.aoa_to_sheet(catRows);
      wsCat['!cols']=[{wch:12},{wch:28},{wch:20},{wch:8},{wch:12},{wch:14},{wch:12},{wch:14}];
      XLSX.utils.book_append_sheet(wb,wsCat,`Categories_${p.ref}`.slice(0,31));
    });

    // ── Feuille synthèse globale ──
    const synthRows=[
      ['ECOBUILD — SYNTHÈSE GLOBALE TOUS PROJETS'],
      [`Édité le : ${new Date().toLocaleDateString('fr-FR')}`],
      [],
      ['Projet','Type','Chef','Budget total','Dépensé','Écart','%','Statut'],
      ...DB.projets.map(p=>{
        const dep=DB.depenses.filter(d=>d.projetId===p.id).reduce((s,d)=>s+d.montant,0);
        return[p.nom,p.type,p.chef||'—',p.budgetTotal,dep,p.budgetTotal-dep,
          p.budgetTotal?dep/p.budgetTotal:0,p.statut];
      }),
      [],
      ['TOTAL','','',
        DB.projets.reduce((s,p)=>s+p.budgetTotal,0),
        DB.depenses.reduce((s,d)=>s+d.montant,0),
        DB.projets.reduce((s,p)=>s+p.budgetTotal,0)-DB.depenses.reduce((s,d)=>s+d.montant,0),
        '',''],
    ];
    const wsSynth=XLSX.utils.aoa_to_sheet(synthRows);
    wsSynth['!cols']=[{wch:28},{wch:16},{wch:18},{wch:16},{wch:14},{wch:14},{wch:10},{wch:12}];
    wsSynth['!merges']=[{s:{r:0,c:0},e:{r:0,c:7}}];
    XLSX.utils.book_append_sheet(wb,wsSynth,'Synthese_Globale');

    const fname=pid?`Ecobuild_${DB.projets.find(p=>p.id===pid)?.ref||'projet'}_rapport.xlsx`:'Ecobuild_rapport_complet.xlsx';
    XLSX.writeFile(wb,fname);
  });
}

