function addProjet(){
  const nom=document.getElementById('p-nom').value.trim();
  if(!nom){alert('Entrez un nom de projet.');return;}
  const bmo=parseFloat(document.getElementById('b-mo').value)||0;
  const bmat=parseFloat(document.getElementById('b-mat').value)||0;
  const bss=parseFloat(document.getElementById('b-ss').value)||0;
  const beq=parseFloat(document.getElementById('b-eq').value)||0;
  const bfg=parseFloat(document.getElementById('b-fg').value)||0;
  DB.projets.push({
    id:uid(),
    ref:document.getElementById('p-ref').value.trim()||'ECO-'+Date.now(),
    nom,type:document.getElementById('p-type').value,
    moa:document.getElementById('p-moa').value,
    lieu:document.getElementById('p-lieu').value,
    chef:document.getElementById('p-chef').value,
    debut:document.getElementById('p-debut').value,
    fin:document.getElementById('p-fin').value,
    desc:document.getElementById('p-desc').value,
    statut:'En cours',
    budget:{mo:bmo,mat:bmat,ss:bss,eq:beq,fg:bfg},
    budgetTotal:bmo+bmat+bss+beq+bfg,
    datec:today()
  });
  ['p-ref','p-nom','p-moa','p-lieu','p-chef','p-debut','p-fin','p-desc'].forEach(id=>document.getElementById(id).value='');
  ['b-mo','b-mat','b-ss','b-eq','b-fg'].forEach(id=>document.getElementById(id).value='0');
  save();renderProjets();refreshSelects();updateBadges();
  if(currentView==='dashboard') setTimeout(renderCharts,80);
}

