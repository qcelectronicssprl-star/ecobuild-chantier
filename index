};

let _fbConfig = null;
let _fbApp    = null;
let _dbRef    = null;   // référence Firebase pour les données (DB)
let _authRef  = null;   // référence Firebase pour les comptes (AUTH)

function loadFbConfig() {
  // Utiliser la config intégrée en priorité
  _fbConfig = FIREBASE_EMBEDDED;
}

function saveFbConfig(cfg) {
  try { localStorage.setItem('eco_firebase_cfg', JSON.stringify(cfg)); } catch(e) {}
}

function isFirebaseConfigured() {
  return _fbConfig && _fbConfig.apiKey && _fbConfig.databaseURL && _fbConfig.projectId;
}

// Lancé par le bouton "Connecter" de l'écran de configuration
function connectFirebase() {
  const cfg = {
    apiKey:       document.getElementById('cfg-apiKey').value.trim(),
    authDomain:   document.getElementById('cfg-authDomain').value.trim(),
    databaseURL:  document.getElementById('cfg-databaseURL').value.trim(),
    projectId:    document.getElementById('cfg-projectId').value.trim(),
    appId:        document.getElementById('cfg-appId').value.trim(),
  };
  const errEl = document.getElementById('fs-err');
  if (!cfg.apiKey || !cfg.databaseURL || !cfg.projectId) {
    errEl.textContent = '⚠️ Les champs apiKey, databaseURL et projectId sont obligatoires.';
    errEl.style.display = 'block'; return;
  }
  if (!cfg.databaseURL.startsWith('https://')) {
    errEl.textContent = '⚠️ databaseURL doit commencer par https://';
    errEl.style.display = 'block'; return;
  }
  errEl.style.display = 'none';
  saveFbConfig(cfg);
  _fbConfig = cfg;
  // Recharger la page pour lancer l'init avec la nouvelle config
  location.reload();
}

// Initialise Firebase et crée les références DB
function initFirebase() {
  if (!isFirebaseConfigured()) return false;
  try {
    _fbApp    = firebase.initializeApp(_fbConfig);
    _dbRef    = firebase.database().ref('ecobuild/db');
    _authRef  = firebase.database().ref('ecobuild/auth');
    return true;
  } catch(e) {
    console.error('Erreur init Firebase :', e);
    return false;
  }
}

