      </div>
    </div>`;
  }).join('');
}

function toggleProjet(id){const el=document.getElementById(id);if(el)el.classList.toggle('open');}
function changeStatutProjet(id,s){if(!s||s==='Statut')return;const p=projetById(id);if(p){p.statut=s;save();renderProjets();}}
function deleteProjet(id){if(confirm('Supprimer ce projet et toutes ses dépenses ?')){DB.projets=DB.projets.filter(p=>p.id!==id);DB.depenses=DB.depenses.filter(d=>d.projetId!==id);save();renderProjets();updateBadges();}}

