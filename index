      </td>
    </tr>`).join('');
  }

  // Tableau cash
  const tbh = document.getElementById('depot-cash-tbody');
  if (!cashs.length) {
    tbh.innerHTML='<tr><td colspan="7" style="text-align:center;color:var(--gris-l);padding:20px">Aucun dépôt cash</td></tr>';
  } else {
    tbh.innerHTML = [...cashs].sort((a,b)=>b.date.localeCompare(a.date)).map(d=>`<tr>
      <td>${d.date}</td>
      <td class="tbl-num" style="font-weight:700;color:var(--ocre)">${fmtN(d.montant)}</td>
      <td>${d.responsable||'—'}</td>
      <td>${projetById(d.projetId)?.ref||'—'}</td>
      <td style="font-size:.72rem;color:var(--gris)">${d.origine||'—'}</td>
      <td>${d.piece||'—'}</td>
      <td class="actions no-print">
        <button class="btn btn-xs btn-bleu" onclick="editDepot('${d.id}')">✏️</button>
        <button class="btn btn-xs btn-sec" onclick="deleteDepot('${d.id}')">🗑</button>
      </td>
    </tr>`).join('');
  }

  // Synthèse par projet
  const tb = document.getElementById('synth-depots-tbody');
  const projetsSynt = DB.projets.length ? DB.projets : [];
  if (!projetsSynt.length) {
    tb.innerHTML='<tr><td colspan="6" style="text-align:center;color:var(--gris-l);padding:20px">Aucun projet.</td></tr>';
  } else {
    tb.innerHTML = projetsSynt.map(p=>{
      const dComp = DB.depots.filter(d=>d.projetId===p.id&&d.type==='compte').reduce((s,d)=>s+d.montant,0);
      const dCash = DB.depots.filter(d=>d.projetId===p.id&&d.type==='cash').reduce((s,d)=>s+d.montant,0);
      const total = dComp+dCash;
      const dep   = DB.depenses.filter(d=>d.projetId===p.id).reduce((s,d)=>s+d.montant,0);
      const solde = total-dep;
      return `<tr>
        <td><strong>${p.ref}</strong><br><small style="color:var(--gris-l)">${p.nom}</small></td>
        <td class="tbl-num" style="color:var(--bleu);font-weight:600">${fmtN(dComp)}</td>
