//  STOCKAGE AUTH — version 3
//  Firebase en priorité, localStorage en fallback
// ═══════════════════════════════════════════════
const AUTH_VER = 3;

let _storageOK = false;
(function detectStorage() {
  try {
    localStorage.setItem('__eco_test__', '1');
    _storageOK = (localStorage.getItem('__eco_test__') === '1');
    localStorage.removeItem('__eco_test__');
  } catch(e) { _storageOK = false; }
})();

function saveAuth() {
  const payload = { _v: AUTH_VER, users: AUTH.users, currentUser: AUTH.currentUser };
  if (_authRef) {
    _authRef.set(payload).catch(e => console.warn('Firebase saveAuth :', e));
  } else if (_storageOK) {
    try { localStorage.setItem('eco_auth', JSON.stringify(payload)); } catch(e) {}
  }
}

// loadAuth() synchrone (localStorage fallback seulement)
// Le chargement Firebase est asynchrone — voir initApp()
function loadAuthLocal() {
  if (!_storageOK) return false;
  try {
    const d = localStorage.getItem('eco_auth');
    if (!d) return false;
    const parsed = JSON.parse(d);
    if (parsed._v === AUTH_VER) {
      AUTH.users       = parsed.users       || [];
      AUTH.currentUser = parsed.currentUser || null;
      return true;
    } else {
      localStorage.removeItem('eco_auth');
      return false;
    }
  } catch(e) { localStorage.removeItem('eco_auth'); return false; }
}

