function renderRapports(){
  const budgetTotal=DB.projets.reduce((s,p)=>s+p.budgetTotal,0);
  const depTotal=DB.depenses.reduce((s,d)=>s+d.montant,0);
  const taux=budgetTotal?Math.round(depTotal/budgetTotal*100):0;
  const term=DB.projets.filter(p=>p.statut==='Terminé').length;
  const pers=DB.personnel.filter(p=>p.statut==='Actif').length;
  document.getElementById('r-bud').textContent=fmtN(budgetTotal);
  document.getElementById('r-dep').textContent=fmtN(depTotal);
  document.getElementById('r-taux').textContent=taux+'%';
  document.getElementById('r-term').textContent=term;
  document.getElementById('r-pers').textContent=pers;

  // Budget vs Réel
  const bvr=document.getElementById('r-bvr');
  if(!DB.projets.length){bvr.innerHTML='<p style="color:var(--gris-l);font-size:.8rem">Aucune donnée.</p>';}
  else bvr.innerHTML=DB.projets.map(p=>{
    const dep=DB.depenses.filter(d=>d.projetId===p.id).reduce((s,d)=>s+d.montant,0);
    const pct=p.budgetTotal?Math.min(100,Math.round(dep/p.budgetTotal*100)):0;
    const over=dep>p.budgetTotal;
    return `<div style="margin-bottom:10px">
      <div style="display:flex;justify-content:space-between;font-size:.78rem;margin-bottom:3px">
        <span><strong>${p.ref}</strong> ${p.nom}</span>
        <span style="color:${over?'var(--rouge)':'var(--eco)'};font-weight:700">${pct}%</span>
      </div>
      <div class="prog-wrap"><div class="prog-fill ${over?'pf-rouge':'pf-eco'}" style="width:${Math.min(100,pct)}%"></div></div>
      <div style="font-size:.67rem;color:var(--gris-l);margin-top:2px">${fmtN(dep)} / ${fmtN(p.budgetTotal)} FCFA</div>
    </div>`;
  }).join('');

  // Cats
  const catTotaux={mo:0,mat:0,ss:0,eq:0,fg:0};
  DB.depenses.forEach(d=>{if(catTotaux[d.cat]!==undefined)catTotaux[d.cat]+=d.montant;});
  const maxCat=Math.max(...Object.values(catTotaux),1);
  document.getElementById('r-cats').innerHTML=Object.entries(catTotaux).map(([k,v])=>`
    <div style="margin-bottom:9px">
      <div style="display:flex;justify-content:space-between;font-size:.77rem;margin-bottom:3px">
        <span class="badge ${CATS[k].cls}">${CATS[k].label}</span>
        <strong>${fmtN(v)} FCFA</strong>
      </div>
      <div class="prog-wrap"><div class="prog-fill" style="width:${Math.round(v/maxCat*100)}%;background:${CATS[k].color}"></div></div>
    </div>`).join('');

  // Top fournisseurs
  const fourTot={};
  DB.depenses.forEach(d=>{if(d.fourNom&&d.fourNom!=='—')fourTot[d.fourNom]=(fourTot[d.fourNom]||0)+d.montant;});
  const sorted=Object.entries(fourTot).sort((a,b)=>b[1]-a[1]).slice(0,6);
  const maxF=sorted[0]?.[1]||1;
  document.getElementById('r-fours').innerHTML=sorted.length?sorted.map(([n,v])=>`
    <div style="margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;font-size:.77rem;margin-bottom:3px"><span>${n}</span><strong>${fmtN(v)} FCFA</strong></div>
      <div class="prog-wrap"><div class="prog-fill pf-eco" style="width:${Math.round(v/maxF*100)}%"></div></div>
    </div>`).join(''):'<p style="color:var(--gris-l);font-size:.8rem">Aucune donnée.</p>';

  // Dépenses par mois
  const mois={};
  DB.depenses.forEach(d=>{const m=d.date?.slice(0,7)||'?';mois[m]=(mois[m]||0)+d.montant;});
  const sortedM=Object.entries(mois).sort();
  const maxM=sortedM.reduce((m,x)=>Math.max(m,x[1]),1);
  document.getElementById('r-mois').innerHTML=sortedM.length?sortedM.map(([m,v])=>`
    <div style="margin-bottom:7px">
      <div style="display:flex;justify-content:space-between;font-size:.77rem;margin-bottom:3px"><span>${m}</span><strong>${fmtN(v)} FCFA</strong></div>
      <div class="prog-wrap"><div class="prog-fill pf-ocre" style="width:${Math.round(v/maxM*100)}%;background:var(--ocre)"></div></div>
    </div>`).join(''):'<p style="color:var(--gris-l);font-size:.8rem">Aucune donnée.</p>';
}

