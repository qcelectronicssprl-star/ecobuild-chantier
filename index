            <td class="tbl-num" style="font-weight:700">${fmtN(p.budgetTotal)}</td>
            <td class="tbl-num" style="font-weight:700;color:${over?'var(--rouge)':'var(--eco)'}">${fmtN(depTotal)}</td>
            <td class="tbl-num" style="font-weight:700;color:${p.budgetTotal-depTotal<0?'var(--rouge)':'var(--eco)'}">${p.budgetTotal-depTotal>=0?'+':''}${fmtN(p.budgetTotal-depTotal)}</td>
