                <div class="prog-wrap" style="flex:1"><div class="prog-fill ${over?'pf-rouge':'pf-eco'}" style="width:${Math.min(100,pct)}%"></div></div>
                <span style="font-size:.7rem;font-weight:700">${pct}%</span>
              </div>
            </td>
          </tr>
        </tfoot>
      </table>

      <!-- Dépenses détaillées du projet -->
      <div style="margin-top:12px;border:1px solid var(--border);border-radius:6px;overflow:hidden">
        <div style="background:var(--eco-xl);padding:8px 14px;font-size:.72rem;font-weight:700;color:var(--eco);display:flex;justify-content:space-between">
          <span>📋 Détail des dépenses (${dep.length})</span>
          <button class="btn btn-xs btn-ocre no-print" onclick="exportExcelProjet('${p.id}')">📥 Export Excel</button>
        </div>
        <table style="width:100%;border-collapse:collapse;font-size:.74rem">
          <thead><tr style="background:var(--ivoire)">
            <th style="padding:6px 10px;text-align:left;font-weight:600;color:var(--gris);border-bottom:1px solid var(--border)">Date</th>
            <th style="padding:6px 10px;text-align:left;font-weight:600;color:var(--gris);border-bottom:1px solid var(--border)">Catégorie</th>
            <th style="padding:6px 10px;text-align:left;font-weight:600;color:var(--gris);border-bottom:1px solid var(--border)">Désignation</th>
            <th style="padding:6px 10px;text-align:left;font-weight:600;color:var(--gris);border-bottom:1px solid var(--border)">Fournisseur</th>
            <th style="padding:6px 10px;text-align:right;font-weight:600;color:var(--gris);border-bottom:1px solid var(--border)">Montant FCFA</th>
            <th style="padding:6px 10px;text-align:left;font-weight:600;color:var(--gris);border-bottom:1px solid var(--border)">Pièce</th>
          </tr></thead>
          <tbody>${dep.length?dep.map((d,i)=>`<tr style="background:${i%2===0?'#fff':var_ivoire()}">
            <td style="padding:5px 10px;border-bottom:1px solid var(--border)">${d.date}</td>
            <td style="padding:5px 10px;border-bottom:1px solid var(--border)"><span class="badge ${CATS[d.cat]?.cls}">${CATS[d.cat]?.label||d.cat}</span></td>
            <td style="padding:5px 10px;border-bottom:1px solid var(--border)">${d.label}</td>
            <td style="padding:5px 10px;border-bottom:1px solid var(--border)">${d.fourNom||'—'}</td>
            <td style="padding:5px 10px;border-bottom:1px solid var(--border);text-align:right;font-weight:700">${fmtN(d.montant)}</td>
            <td style="padding:5px 10px;border-bottom:1px solid var(--border)">${d.piece||'—'}</td>
          </tr>`).join(''):'<tr><td colspan="6" style="text-align:center;padding:14px;color:var(--gris-l)">Aucune dépense saisie</td></tr>'}</tbody>
        </table>
      </div>
    </div>`;
  }).join('');
}

function var_ivoire(){return '#F4F7F6';}

