const FIREBASE_EMBEDDED = {
  apiKey:            "AIzaSyC8Z3oSZFVJWA2DLtyTz_WLzb4bKywTHk8",
  authDomain:        "ecobuild-chantier.firebaseapp.com",
  databaseURL:       "https://ecobuild-chantier-default-rtdb.europe-west1.firebasedatabase.app",
