  fournisseurs:{title:'Fournisseurs',       badge:'🏭 Partenaires'},
  depots:      {title:'Dépôts',             badge:'🏦 Trésorerie'},
  rapports:    {title:'Rapports',           badge:'📈 Analyse & Export'},
  admin:       {title:'Accès & Utilisateurs',badge:'🔑 Administration'},
};
let currentView='dashboard';

function go(name){
  currentView=name;
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('view-'+name).classList.add('active');
  document.querySelectorAll('.nav-btn').forEach(b=>{
    if(b.getAttribute('onclick')&&b.getAttribute('onclick').includes("'"+name+"'"))b.classList.add('active');
  });
  const m=META[name];
  document.getElementById('page-title').textContent=m.title;
  document.getElementById('tb-badge').textContent=m.badge;
  refreshSelects();
  if(name==='dashboard')  renderDashboard();
  if(name==='projets')    renderProjets();
  if(name==='depenses')   renderDepenses();
  if(name==='budget')     renderBudget();
  if(name==='personnel')  renderPersonnel();
  if(name==='fournisseurs')renderFournisseurs();
  if(name==='depots')      renderDepots();
  if(name==='rapports')   renderRapports();
  if(name==='admin')      renderAdmin();
  updateBadges();
}

function btnAction(){
  if(currentView==='projets')    document.getElementById('p-nom').focus();
  if(currentView==='depenses')   document.getElementById('dep-label').focus();
  if(currentView==='personnel')  document.getElementById('pers-nom').focus();
  if(currentView==='fournisseurs')document.getElementById('f-nom').focus();
  if(currentView==='rapports')   exportExcel();
}

function updateBadges(){
  document.getElementById('nb-projets').textContent=DB.projets.length;
  document.getElementById('nb-dep').textContent=DB.depenses.length;
  document.getElementById('nb-pers').textContent=DB.personnel.length;
  document.getElementById('nb-four').textContent=DB.fournisseurs.length;
  document.getElementById('nb-dep-tr').textContent=DB.depots.length;
}

function refreshSelects(){
  const opts=DB.projets.map(p=>`<option value="${p.id}">${p.ref} — ${p.nom}</option>`).join('');
  const empty='<option value="">-- Sélectionner --</option>';
  ['dep-projet','bud-projet','pers-projet','dc-projet','dh-projet'].forEach(id=>{
    const el=document.getElementById(id);if(!el)return;
    el.innerHTML=(id==='bud-projet'?'<option value="">Tous les projets</option>':empty)+opts;
  });
  // Filtre dépôts
  const dfp=document.getElementById('df-projet');
  if(dfp)dfp.innerHTML='<option value="">Tous</option>'+opts;
  const fOpts=DB.fournisseurs.map(f=>`<option value="${f.id}">${f.nom}</option>`).join('');
  const fd=document.getElementById('dep-four');if(fd)fd.innerHTML='<option value="">-- Fournisseur --</option>'+fOpts;
  // Filtre dépenses
  const fp=document.getElementById('f-projet');
  if(fp)fp.innerHTML='<option value="">Tous</option>'+opts;
}

function projetById(id){return DB.projets.find(p=>p.id===id);}
function fourById(id){return DB.fournisseurs.find(f=>f.id===id);}

