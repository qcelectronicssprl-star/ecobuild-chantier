let depotTab = 'compte';

function switchDepotTab(tab) {
  depotTab = tab;
  document.getElementById('depot-mode-compte').style.display = tab==='compte' ? '' : 'none';
  document.getElementById('depot-mode-cash').style.display   = tab==='cash'   ? '' : 'none';
  document.getElementById('tab-compte').classList.toggle('active', tab==='compte');
  document.getElementById('tab-cash').classList.toggle('active',   tab==='cash');
}

function previewDepot(type) {
  const id = type==='compte' ? 'dc-montant' : 'dh-montant';
  const prevId = type==='compte' ? 'prev-compte' : 'prev-cash';
  const val = parseFloat(document.getElementById(id).value)||0;
  document.getElementById(prevId).textContent = fmtN(val)+' FCFA';
}

function addDepot(type) {
  let d = {};
  if (type === 'compte') {
    const montant = parseFloat(document.getElementById('dc-montant').value)||0;
    if (!montant) { alert('Entrez un montant.'); return; }
    d = {
      id:uid(), type:'compte',
      date:document.getElementById('dc-date').value||today(),
      montant,
      banque:document.getElementById('dc-banque').value,
      numcompte:document.getElementById('dc-numcompte').value,
      projetId:document.getElementById('dc-projet').value,
      deposant:document.getElementById('dc-deposant').value,
      piece:document.getElementById('dc-piece').value,
      origine:document.getElementById('dc-origine').value,
      obs:document.getElementById('dc-obs').value,
      datec:today()
    };
    ['dc-montant','dc-banque','dc-numcompte','dc-deposant','dc-piece','dc-obs']
      .forEach(id=>document.getElementById(id).value=id==='dc-montant'?'0':'');
    document.getElementById('prev-compte').textContent='0 FCFA';
  } else {
    const montant = parseFloat(document.getElementById('dh-montant').value)||0;
    if (!montant) { alert('Entrez un montant.'); return; }
    d = {
      id:uid(), type:'cash',
      date:document.getElementById('dh-date').value||today(),
      montant,
      responsable:document.getElementById('dh-responsable').value,
      projetId:document.getElementById('dh-projet').value,
      piece:document.getElementById('dh-piece').value,
      origine:document.getElementById('dh-origine').value,
      obs:document.getElementById('dh-obs').value,
      datec:today()
    };
    ['dh-montant','dh-responsable','dh-piece','dh-obs']
      .forEach(id=>document.getElementById(id).value=id==='dh-montant'?'0':'');
    document.getElementById('prev-cash').textContent='0 FCFA';
  }
  DB.depots.push(d);
  save(); renderDepots(); updateBadges();
  if(currentView==='dashboard') setTimeout(renderCharts,80);
}

function renderDepots() {
  const filtType   = document.getElementById('df-type')?.value||'';
  const filtProjet = document.getElementById('df-projet')?.value||'';
  const filtDu     = document.getElementById('df-du')?.value||'';
  const filtAu     = document.getElementById('df-au')?.value||'';

  let deps = [...DB.depots];
  if (filtType)   deps = deps.filter(d=>d.type===filtType);
  if (filtProjet) deps = deps.filter(d=>d.projetId===filtProjet);
  if (filtDu)     deps = deps.filter(d=>d.date>=filtDu);
  if (filtAu)     deps = deps.filter(d=>d.date<=filtAu);

  const comptes = deps.filter(d=>d.type==='compte');
  const cashs   = deps.filter(d=>d.type==='cash');
  const totComp = comptes.reduce((s,d)=>s+d.montant,0);
  const totCash = cashs.reduce((s,d)=>s+d.montant,0);
  const totAll  = totComp+totCash;

  // KPIs
  const allDep = DB.depots;
  document.getElementById('tr-total').textContent   = fmtN(allDep.reduce((s,d)=>s+d.montant,0));
