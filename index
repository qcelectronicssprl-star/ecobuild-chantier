  ss:  { label:'Sous-traitant',   cls:'b-ss',  ccls:'c-ss',  color:'#6D28D9' },
  eq:  { label:'Équipement',      cls:'b-eq',  ccls:'c-eq',  color:'#1D4ED8' },
